# 容器架构演示模板，复制为 .env.production。
# 下列密码/token仅用于本机演示；外部部署前请自行替换并配置HTTPS与访问控制。
POSTGRES_DB=mathkb
POSTGRES_USER=mathkb
POSTGRES_PASSWORD=local-postgres-change-me
MATHKB_SERVER__API_TOKEN=local-demo-token-change-me
MATHKB_LLM__PROVIDER=stub
MATHKB_LLM__API_KEY=
MATHKB_LLM__BASE_URL=https://api.deepseek.com/v1
MATHKB_LLM__MODEL=deepseek-chat
MATHKB_EMBEDDING__PROVIDER=hash
MATHKB_EMBEDDING__DIM=512
MATHKB_RERANK__ENABLED=false
MATHKB_CACHE__TTL_SECONDS=300
# 以下仅用于项目内scripts/check_stack.py检查时覆盖；Compose会注入容器地址。
MATHKB_DATABASE_URL=postgresql+psycopg://mathkb:local-postgres-change-me@postgres:5432/mathkb
MATHKB_VECTOR__PROVIDER=pgvector
MATHKB_QUEUE__PROVIDER=celery
MATHKB_QUEUE__REDIS_URL=redis://redis:6379/0
MATHKB_CACHE__ENABLED=true
MATHKB_CACHE__REDIS_URL=redis://redis:6379/1
