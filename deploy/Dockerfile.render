FROM node:22-alpine AS frontend
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim AS runtime
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app/src PIP_NO_CACHE_DIR=1 \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 MATHKB_ENV=prod \
    TOKENIZERS_PARALLELISM=false OMP_NUM_THREADS=2
WORKDIR /app
RUN useradd --create-home --uid 10001 appuser
COPY requirements*.txt ./
RUN pip install --index-url https://download.pytorch.org/whl/cpu 'torch>=2.6,<3' && \
    pip install -r requirements-online.txt
# The real BGE model is included in the image. No download or silent hash fallback at runtime.
ARG BGE_REVISION=7999e1d3359715c523056ef9478215996d62a620
RUN HF_HUB_OFFLINE=0 TRANSFORMERS_OFFLINE=0 python -c \
    "from huggingface_hub import snapshot_download; snapshot_download('BAAI/bge-small-zh-v1.5', revision='$BGE_REVISION', local_dir='/opt/mathkb-model', ignore_patterns=['pytorch_model.bin', '.git*'])"
COPY pyproject.toml alembic.ini ./
COPY migrations/ ./migrations/
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY deploy/online.py ./deploy/online.py
COPY data/full/ ./data/full/
COPY --from=frontend /build/frontend/dist/ ./frontend/dist/
RUN python scripts/warm_online_index.py
RUN mkdir -p /data && chown -R appuser:appuser /app /data
USER root
EXPOSE 8000
# Initialize the mounted disk, then run the application as an unprivileged user.
CMD ["sh", "-c", "chown appuser:appuser /data && exec runuser -u appuser -- python deploy/online.py"]
