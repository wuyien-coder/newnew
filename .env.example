# 本地离线演示模板；复制为 .env 后不会调用收费模型。
MATHKB_ENV=dev
MATHKB_LOG_LEVEL=INFO
MATHKB_LOG_JSON=false
MATHKB_CREATE_SCHEMA=true
MATHKB_DATABASE_URL=sqlite:///./.index/full/mathkb.db
MATHKB_DATA_DIR=./data/full
MATHKB_INDEX_DIR=./.index
# 默认使用仓库内全部传记；可填写外部目录覆盖。
MATHKB_BIOGRAPHIES_DIR=
MATHKB_LLM__PROVIDER=stub
MATHKB_LLM__API_KEY=
MATHKB_LLM__BASE_URL=https://api.deepseek.com/v1
MATHKB_LLM__MODEL=deepseek-chat
MATHKB_LLM__TEMPERATURE=0.3
MATHKB_LLM__MAX_TOKENS=1200
MATHKB_LLM__PRICE_INPUT=0.0
MATHKB_LLM__PRICE_OUTPUT=0.0
MATHKB_EMBEDDING__PROVIDER=hash
MATHKB_EMBEDDING__MODEL_NAME=BAAI/bge-small-zh-v1.5
MATHKB_EMBEDDING__CACHE_DIR=./models
MATHKB_EMBEDDING__DIM=512
MATHKB_RERANK__ENABLED=false
MATHKB_RERANK__MODEL_NAME=BAAI/bge-reranker-base
MATHKB_VECTOR__PROVIDER=memory
MATHKB_VECTOR__PERSIST_DIR=./.index/chroma
MATHKB_KEYWORD__PERSIST_DIR=./.index/bm25
MATHKB_KG__PROVIDER=relational
MATHKB_QUEUE__PROVIDER=local
MATHKB_QUEUE__REDIS_URL=redis://127.0.0.1:6379/0
MATHKB_CACHE__ENABLED=false
MATHKB_CACHE__REDIS_URL=redis://127.0.0.1:6379/1
MATHKB_CACHE__TTL_SECONDS=300
MATHKB_SERVER__HOST=127.0.0.1
MATHKB_SERVER__PORT=8010
MATHKB_SERVER__CORS_ORIGINS=["http://127.0.0.1:8010","http://localhost:8010","http://localhost:5173"]
MATHKB_SERVER__API_TOKEN=
